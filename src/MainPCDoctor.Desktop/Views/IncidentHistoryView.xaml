<Page x:Class="MainPCDoctor.Desktop.Views.IncidentHistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Incident History">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="INCIDENT HISTORY (30 DAYS)"
                   Style="{StaticResource HeadingMedium}" Margin="0,0,0,16" />

        <ListView Grid.Row="1" x:Name="IncidentList"
                  Background="{StaticResource BgSurfaceBrush}"
                  BorderBrush="{StaticResource BorderSubtleBrush}"
                  BorderThickness="1"
                  Foreground="{StaticResource TextPrimaryBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time"        Width="160" DisplayMemberBinding="{Binding StartedAt}" />
                    <GridViewColumn Header="Type"        Width="160" DisplayMemberBinding="{Binding BottleneckType}" />
                    <GridViewColumn Header="Status"      Width="100" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Duration (s)" Width="100" DisplayMemberBinding="{Binding DurationSeconds}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>

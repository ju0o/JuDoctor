<Page x:Class="MainPCDoctor.Desktop.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Settings">

    <StackPanel Margin="24">
        <TextBlock Text="SETTINGS" Style="{StaticResource HeadingMedium}" Margin="0,0,0,24" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="STARTUP" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheck"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Content="Launch MainPC Doctor on Windows startup"
                              Checked="StartupCheck_Changed"
                              Unchecked="StartupCheck_Changed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ABOUT" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12" />
                <TextBlock x:Name="VersionText" Style="{StaticResource BodyText}" />
                <TextBlock Text="Windows hardware monitor — CPU &amp; RAM bottleneck analysis."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

    </StackPanel>
</Page>

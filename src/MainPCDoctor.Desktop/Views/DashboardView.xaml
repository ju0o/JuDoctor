<Page x:Class="MainPCDoctor.Desktop.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeepBrush}"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="SYSTEM STATUS" Style="{StaticResource HeadingMedium}" Margin="0,0,0,16" />

            <!-- Metric cards row -->
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="CpuValueText" Text="0%" Style="{StaticResource MetricValue}" Margin="0,0,0,8" />
                        <Border x:Name="CpuTrack" Style="{StaticResource GaugeTrack}" SizeChanged="Track_SizeChanged">
                            <Border x:Name="CpuBar" Height="6" CornerRadius="3"
                                    Background="{StaticResource CyanPrimaryBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Border>
                        <TextBlock x:Name="CpuTempText" Text="" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="RamValueText" Text="0%" Style="{StaticResource MetricValue}" Margin="0,0,0,8" />
                        <Border x:Name="RamTrack" Style="{StaticResource GaugeTrack}" SizeChanged="Track_SizeChanged">
                            <Border x:Name="RamBar" Height="6" CornerRadius="3"
                                    Background="{StaticResource GreenOkBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Border>
                        <TextBlock x:Name="RamFreeText" Text="" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="GpuValueText" Text="0%" Style="{StaticResource MetricValue}" Margin="0,0,0,8" />
                        <Border x:Name="GpuTrack" Style="{StaticResource GaugeTrack}" SizeChanged="Track_SizeChanged">
                            <Border x:Name="GpuBar" Height="6" CornerRadius="3"
                                    Background="{StaticResource PurpleAccentBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Border>
                        <TextBlock x:Name="GpuTempText" Text="" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DISK" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="DiskValueText" Text="0%" Style="{StaticResource MetricValue}" Margin="0,0,0,8" />
                        <Border x:Name="DiskTrack" Style="{StaticResource GaugeTrack}" SizeChanged="Track_SizeChanged">
                            <Border x:Name="DiskBar" Height="6" CornerRadius="3"
                                    Background="{StaticResource AmberWarnBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Border>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Top Processes -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOP PROCESSES" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="By CPU" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TopCpuText" Text="—" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="By RAM" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TopRamText" Text="—" Style="{StaticResource BodyText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

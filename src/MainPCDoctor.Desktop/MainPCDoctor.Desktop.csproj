    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MainPCDoctor.Core\MainPCDoctor.Core.csproj" />
    <ProjectReference Include="..\..\src\MainPCDoctor.Storage\MainPCDoctor.Storage.csproj" />
    <ProjectReference Include="..\..\src\MainPCDoctor.Platform.Windows\MainPCDoctor.Platform.Windows.csproj" />
  </ItemGroup>

</Project>

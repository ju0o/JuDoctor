<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === Cyber Dark Palette === -->
    <Color x:Key="BgDeepColor">#FF0A0D12</Color>
    <Color x:Key="BgSurfaceColor">#FF0F1419</Color>
    <Color x:Key="BgElevatedColor">#FF151C25</Color>
    <Color x:Key="BgCardColor">#FF1A2233</Color>

    <Color x:Key="CyanPrimaryColor">#FF00F5FF</Color>
    <Color x:Key="CyanDimColor">#FF00B8CC</Color>
    <Color x:Key="GreenOkColor">#FF00FF88</Color>
    <Color x:Key="AmberWarnColor">#FFFFB800</Color>
    <Color x:Key="RedCritColor">#FFFF3D5A</Color>
    <Color x:Key="PurpleAccentColor">#FF9B59FF</Color>

    <Color x:Key="TextPrimaryColor">#FFE8F4FF</Color>
    <Color x:Key="TextSecondaryColor">#FF7A9BBD</Color>
    <Color x:Key="TextDimColor">#FF3D5470</Color>

    <Color x:Key="BorderSubtleColor">#FF1E2D3D</Color>
    <Color x:Key="BorderGlowColor">#3300F5FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush"      Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush"   Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush"  Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgCardBrush"      Color="{StaticResource BgCardColor}" />

    <SolidColorBrush x:Key="CyanPrimaryBrush"  Color="{StaticResource CyanPrimaryColor}" />
    <SolidColorBrush x:Key="CyanDimBrush"      Color="{StaticResource CyanDimColor}" />
    <SolidColorBrush x:Key="GreenOkBrush"      Color="{StaticResource GreenOkColor}" />
    <SolidColorBrush x:Key="AmberWarnBrush"    Color="{StaticResource AmberWarnColor}" />
    <SolidColorBrush x:Key="RedCritBrush"      Color="{StaticResource RedCritColor}" />
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource PurpleAccentColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="{StaticResource TextDimColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderGlowBrush"    Color="{StaticResource BorderGlowColor}" />

</ResourceDictionary>
